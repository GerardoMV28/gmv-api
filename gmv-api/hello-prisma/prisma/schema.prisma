generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Rol {
  id          Int     @id @default(autoincrement())
  description String  @db.VarChar(200)
  status      Boolean
  users       User[]
}

model User {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(200)
  lastname     String    @db.VarChar(205)
  username     String    @unique @db.VarChar(150)
  password     String
  hash         String?
  created_dt   DateTime  @default(now()) @db.Date
  refreshToken String    @default("")
  rol_id       Int?
  email        String?   @unique @db.VarChar(150)
  lastLogin    DateTime? @db.Timestamp(6)
  isActive     Boolean?  @default(true)
  logs         Logs[]
  Session      Session[]
  tasks        Task[]
  rol          Rol?      @relation(fields: [rol_id], references: [id])
}

model Task {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(250)
  description String    @db.VarChar(200)
  priority    Boolean
  created_dt  DateTime  @default(now()) @db.Date
  user_id     Int
  completed   Boolean?  @default(false)
  dueDate     DateTime? @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @db.Timestamp(6)
  user        User      @relation(fields: [user_id], references: [id])
}

model Logs {
  id         Int      @id @default(autoincrement())
  statusCode Int
  timeStamp  DateTime @default(now())
  path       String   @db.VarChar(200)
  error      String   @db.VarChar(200)
  errorCode  String   @db.VarChar(200)
  sesion_id  Int?
  eventType  String?  @db.VarChar(50)
  severity   String?  @default("INFO") @db.VarChar(20)
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?
  user       User?    @relation(fields: [sesion_id], references: [id])

  @@index([eventType])
  @@index([timeStamp])
}

model Session {
  id        String   @id
  userId    Int
  token     String   @unique
  expiresAt DateTime @db.Timestamp(6)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  isRevoked Boolean  @default(false)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([token])
  @@index([userId])
}
